@page "/landing"
@layout PublicLayout

<!-- ── HERO ─────────────────────────────────────────────────── -->
<section class="landing-hero">

    <div class="landing-title animate-fadeInUp">
        Cada día,<br />
        un nuevo <span class="highlight">reto.</span>
    </div>

    <p class="landing-subtitle animate-fadeInUp delay-1">
        ChallengMe! te propone cada día un reto personalizado
        según tus gustos. Complétalo, acumula puntos y mantén
        tu racha viva.
    </p>

    <div class="landing-cta-group animate-fadeInUp delay-2">
        <a href="@AppRouters.Registro" class="btn btn-primary btn-lg">
            Empieza gratis
        </a>
        <a href="#como-funciona" class="btn btn-secondary btn-lg">
            Ver cómo funciona
        </a>
    </div>

    <div class="landing-features animate-fadeInUp delay-3">
        <div class="feature-card">
            <div class="feature-icon">🎯</div>
            <div class="feature-title">Retos personalizados</div>
            <p class="feature-desc">
                La IA genera cada día un reto pensado
                específicamente para ti, según tus intereses
                y nivel de dificultad.
            </p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">🔥</div>
            <div class="feature-title">Sistema de rachas</div>
            <p class="feature-desc">
                Completa un reto cada día y construye tu racha.
                Cuanto más larga, más motivación para no romperla.
            </p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">🏆</div>
            <div class="feature-title">Ranking global</div>
            <p class="feature-desc">
                Compite con otros usuarios, acumula puntos y
                escala posiciones en el ranking para demostrar
                tu constancia.
            </p>
        </div>
    </div>

</section>

