<!-- ── CTA FINAL ─────────────────────────────────────────────── -->
<section style="padding: var(--space-2xl) var(--space-lg); text-align: center;">
    <div class="card" style="max-width: 600px; margin: 0 auto; padding: var(--space-2xl);">
        <h2 class="h1" style="margin-bottom: var(--space-md);">
            ¿Listo para el primer reto?
        </h2>
        <p class="landing-subtitle" style="margin-bottom: var(--space-xl);">
            Regístrate gratis, elige tus intereses y en menos
            de un minuto tendrás tu primer reto del día.
        </p>
        <a href="@AppRouters.Registro" class="btn btn-primary btn-lg btn-full">
            Crear mi cuenta gratis
        </a>
        <p class="text-sm text-muted" style="margin-top: var(--space-md);">
            ¿Ya tienes cuenta?
            <a href="@AppRouters.Login">Inicia sesión</a>
        </p>
    </div>
</section>
<script>
    (function () {
        const carousel = document.getElementById('previewsCarousel');
        const indicators = document.querySelectorAll('.previews-indicator');
        const total = 4;
        let current = 0;

        // Obtiene los 4 items del carrusel
        function getItems() {
            return carousel.querySelectorAll('.preview-item');
        }

        // Actualiza qué indicador está activo
        function setActive(index) {
            current = index;
            indicators.forEach((ind, i) => {
                ind.classList.toggle('active', i === index);
            });
        }

        // Navega a un item concreto
        function goTo(index) {
            const items = getItems();
            if (!items[index]) return;
            items[index].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            setActive(index);
        }

        // Botones de flecha
        document.getElementById('nextBtn').addEventListener('click', function () {
            goTo((current + 1) % total);
        });

        document.getElementById('prevBtn').addEventListener('click', function () {
            goTo((current - 1 + total) % total);
        });

        // Click en indicadores
        indicators.forEach(function (ind) {
            ind.addEventListener('click', function () {
                goTo(parseInt(ind.dataset.index));
            });
        });

        // Drag con ratón
        let isDragging = false;
        let startX = 0;
        let scrollStart = 0;

        carousel.addEventListener('mousedown', function (e) {
            isDragging = true;
            startX = e.pageX - carousel.offsetLeft;
            scrollStart = carousel.scrollLeft;
        });

        carousel.addEventListener('mousemove', function (e) {
            if (!isDragging) return;
            e.preventDefault();
            carousel.scrollLeft = scrollStart - (e.pageX - carousel.offsetLeft - startX);
        });

        carousel.addEventListener('mouseup', function () { isDragging = false; });
        carousel.addEventListener('mouseleave', function () { isDragging = false; });

        // Actualiza indicador al hacer scroll manual o touch
        carousel.addEventListener('scroll', function () {
            const items = getItems();
            const center = carousel.scrollLeft + carousel.offsetWidth / 2;
            let closest = 0;
            let minDist = Infinity;
            items.forEach(function (el, i) {
                const dist = Math.abs(el.offsetLeft + el.offsetWidth / 2 - center);
                if (dist < minDist) { minDist = dist; closest = i; }
            });
            setActive(closest);
        });
    })();
</script>