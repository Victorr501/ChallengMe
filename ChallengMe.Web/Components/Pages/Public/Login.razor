@page "/login"
@using ChallengMe.Web.Models.Auth
@using ChallengMe.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@layout PublicLayout
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ApiClient Api

<div class="auth-container">
    <div class="auth-card animate-scaleIn">

        <div class="auth-logo">
            Challenge<span>Me!</span>
        </div>

        <!-- Título -->
        <h1 class="h2" style="text-align:center; margin-bottom: var(--space-xs);">
            Bienvenido de nuevo
        </h1>
        <p class="text-sm text-muted" style="text-align:center; margin-bottom: var(--space-xl);">
            Inicia sesión para ver tu reto del día
        </p>

        <!-- ── BOTÓN AZURE AD ─────────────────────────── -->
        <button class="btn-microsoft" @onclick="LoginConMicrosoft">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 21 21">
                <rect x="1" y="1" width="9" height="9" fill="#f25022" />
                <rect x="11" y="1" width="9" height="9" fill="#7fba00" />
                <rect x="1" y="11" width="9" height="9" fill="#00a4ef" />
                <rect x="11" y="11" width="9" height="9" fill="#ffb900" />
            </svg>
            Continuar con Microsoft
        </button>

        <!-- ── DIVISOR ─────────────────────────────────── -->
        <div class="auth-divider">o inicia sesión con email</div>

        <!-- ── ALERTA DE ERROR ───────────────────────── -->
        @if (resultado.TieneError)
        {
            <div class="alert alert-error animate-fadeIn">
                <span>⚠</span>
                <span>@resultado.Error</span>
            </div>
        }

        <!-- ── FORMULARIO ────────────────────────────── -->
        <div class="form-group">
            <label class="form-label" for="email">Email</label>
            <input class="form-input @(errores.ContainsKey("email") ? "input-error" : "")"
                   id="email"
                   type="email"
                   placeholder="tu@email.com"
                   @bind="modelo.Email"
                   @bind:event="oninput" />
            @if (errores.ContainsKey("email"))
            {
                <span class="form-error">@errores["email"]</span>
            }
        </div>

        <div class="form-group">
            <label class="form-label" for="password">Contraseña</label>
            <div class="input-password-wrap">
                <input class="form-input @(errores.ContainsKey("password") ? "input-error" : "")"
                       id="password"
                       type="@(mostrarPassword ? "text" : "password")"
                       placeholder="Tu contraseña"
                       @bind="modelo.Password"
                       @bind:event="oninput" />
                <button class="btn-toggle-password" type="button" @onclick="TogglePassword">
                    @(mostrarPassword ? "🙈" : "👁")
                </button>
            </div>
            @if (errores.ContainsKey("password"))
            {
                <span class="form-error">@errores["password"]</span>
            }
        </div>

        <!-- ── RECORDARME + OLVIDÉ CONTRASEÑA ─────── -->
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom: var(--space-md);">
            <label style="display:flex; align-items:center; gap: var(--space-sm); cursor:pointer;">
                <input type="checkbox"
                       @bind="modelo.Recordarme"
                       style="accent-color: var(--color-primary); width:15px; height:15px;" />
                <span class="text-sm text-muted">Recordarme</span>
            </label>
            <a href="@AppRouters.RecuperarPassword" class="text-sm">
                ¿Olvidaste tu contraseña?
            </a>
        </div>

        <!-- ── BOTÓN SUBMIT ───────────────────────── -->
        <button class="btn btn-primary btn-full btn-lg"
                @onclick="LoginConEmail"
                disabled="@resultado.Cargando">
            @if (resultado.Cargando)
            {
                <span class="spinner"></span>
                <span>Entrando...</span>
            }
            else
            {
                <span>Iniciar sesión</span>
            }
        </button>

        <!-- ── INTENTOS BLOQUEADO ─────────────────── -->
        @if (bloqueado)
        {
            <div class="alert alert-warning animate-fadeIn" style="margin-top: var(--space-md);">
                <span>🔒</span>
                <span>Demasiados intentos fallidos. Cuenta bloqueada temporalmente.</span>
            </div>
        }

        <p class="text-sm text-muted" style="text-align:center; margin-top: var(--space-lg);">
            ¿No tienes cuenta?
            <a href="@AppRouters.Registro">Regístrate gratis</a>
        </p>

    </div>
</div>

@code {

    private LoginShipment modelo = new();
    private UiResult resultado = UiResult.Inicial();
    private bool mostrarPassword = false;
    private bool bloqueado = false;
    private int intentosFallidos = 0;
    private const int MaxIntentos = 5;

    private Dictionary<string, string> errores = new();

    [Inject] IConfiguration Config { get; set; } = default!;

    private void LoginConMicrosoft()
    {
        var tenantId = Config["MicrosoftAuth:TenantId"];
        var clientId = Config["MicrosoftAuth:ClientId"];
        var redirectUri = Config["MicrosoftAuth:RedirectUri"];

        var url = "https://login.microsoftonline.com/" + tenantId + "/oauth2/v2.0/authorize"
                + "?client_id=" + Uri.EscapeDataString(clientId!)
                + "&response_type=code"
                + "&redirect_uri=" + Uri.EscapeDataString(redirectUri!)
                + "&scope=" + Uri.EscapeDataString("openid profile email")
                + "&response_mode=query";

        Console.WriteLine("Redirigiendo a Microsoft Login: " + url);
        
        Navigation.NavigateTo(url, forceLoad: true);
    }

    private async Task LoginConEmail()
    {
        
        if (bloqueado) return;

        errores = LoginTools.ValidarLogin(modelo.Email, modelo.Password);
        if (errores.Count > 0) return;

        resultado = UiResult.EnCarga();

        try
        {
            var response = await Api.Http.PostAsJsonAsync(
                "/api/auth/login-email",
                new LoginEmailRequest
                {
                    Email = modelo.Email,
                    Password = modelo.Password
                });

            if (!response.IsSuccessStatusCode)
            {
                intentosFallidos++;

                if (intentosFallidos >= MaxIntentos)
                {
                    bloqueado = true;
                    resultado = UiResult.Inicial();
                }
                else
                {
                    resultado = UiResult.ConError("Email o contraseña incorrectos.");
                }
                return;
            }

            var authResponse = await response.Content.ReadFromJsonAsync<AuthResponse>();

            if (authResponse?.Token is null)
            {
                resultado = UiResult.ConError("Respuesta inválida del servidor.");
                return;
            }

            intentosFallidos = 0;

            await JS.InvokeVoidAsync("localStorage.setItem", AuthConstants.JwtKey, authResponse.Token);

            var provider = AuthStateProvider as JwtAuthStateProvider;
            provider?.EstablecerToken(authResponse.Token);

            Navigation.NavigateTo(AppRouters.Dashboard, forceLoad: true);

        }
        catch (Exception)
        {
            intentosFallidos++;

            if (intentosFallidos >= MaxIntentos)
            {
                bloqueado = true;
                resultado = UiResult.Inicial();
            }
            else
            {
                resultado = UiResult.ConError("Ha ocurrido un error. Inténtalo de nuevo.");
            }
        }
    }

    private void TogglePassword() => mostrarPassword = !mostrarPassword;

    
}