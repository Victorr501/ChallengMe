@page "/reset-password"
@layout PublicLayout
@inject AuthApiService AuthService
@inject NavigationManager Navigation

<div class="auth-container">
    <div class="auth-card animate-scaleIn">

        <div class="auth-logo">
            Challenge<span>Me!</span>
        </div>

        @if (string.IsNullOrEmpty(token))
        {
            <div class="alert alert-error animate-fadeIn" style="margin-bottom: var(--space-lg);">
                <span>⚠</span>
                <span>El enlace de recuperación no es válido.</span>
            </div>
            <p class="text-sm text-muted" style="text-align:center;">
                <a href="@AppRouters.RecuperarPassword">Solicitar un nuevo enlace</a>
            </p>
        }
        else if (resultado.Exitoso)
        {
            <div class="alert alert-success animate-fadeIn">
                <span>✓</span>
                <span>Contraseña actualizada correctamente.</span>
            </div>
            <p class="text-sm text-muted" style="text-align:center; margin-top: var(--space-lg);">
                <a href="@AppRouters.Login">Iniciar sesión</a>
            </p>
        }
        else
        {
            <h1 class="h2" style="text-align:center; margin-bottom: var(--space-xs);">
                Nueva contraseña
            </h1>
            <p class="text-sm text-muted" style="text-align:center; margin-bottom: var(--space-xl);">
                Introduce tu nueva contraseña
            </p>

            @if (resultado.TieneError)
            {
                <div class="alert alert-error animate-fadeIn">
                    <span>⚠</span>
                    <span>@resultado.Error</span>
                </div>
            }

            <div class="form-group">
                <label class="form-label" for="password">Nueva contraseña</label>
                <div class="input-password-wrap">
                    <input class="form-input @(errores.ContainsKey("password") ? "input-error" : "")"
                           id="password"
                           type="@(mostrarPassword ? "text" : "password")"
                           placeholder="Mínimo 8 caracteres"
                           @bind="password"
                           @bind:event="oninput" />
                    <button class="btn-toggle-password" type="button" @onclick="TogglePassword">
                        @(mostrarPassword ? "🙈" : "👁")
                    </button>
                </div>
                @{
                    var fortaleza = RegistarTools.Evaluar(password);
                }
                @if (!string.IsNullOrEmpty(password))
                {
                    <div class="password-strength">
                        <div class="password-strength__bar">
                            <div class="password-strength__fill strength-@fortaleza.Nivel"></div>
                        </div>
                        <span class="password-strength__label">@fortaleza.Texto</span>
                    </div>
                }
                @if (errores.ContainsKey("password"))
                {
                    <span class="form-error">@errores["password"]</span>
                }
            </div>

            <div class="form-group">
                <label class="form-label" for="passwordConfirm">Confirmar contraseña</label>
                <input class="form-input @(errores.ContainsKey("passwordConfirm") ? "input-error" : "")"
                       id="passwordConfirm"
                       type="password"
                       placeholder="Repite la contraseña"
                       @bind="passwordConfirm"
                       @bind:event="oninput" />
                @if (errores.ContainsKey("passwordConfirm"))
                {
                    <span class="form-error">@errores["passwordConfirm"]</span>
                }
            </div>

            <button class="btn btn-primary btn-full btn-lg"
                    style="margin-top: var(--space-md);"
                    @onclick="CambiarPassword"
                    disabled="@resultado.Cargando">
                @if (resultado.Cargando)
                {
                    <span class="spinner"></span>
                    <span>Guardando...</span>
                }
                else
                {
                    <span>Guardar contraseña</span>
                }
            </button>

            <p class="text-sm text-muted" style="text-align:center; margin-top: var(--space-lg);">
                <a href="@AppRouters.Login">Volver al inicio de sesión</a>
            </p>
        }

    </div>
</div>

@code {

    [SupplyParameterFromQuery(Name = "token")]
    private string? token { get; set; }

    private string password = string.Empty;
    private string passwordConfirm = string.Empty;
    private UiResult resultado = UiResult.Inicial();
    private bool mostrarPassword = false;
    private Dictionary<string, string> errores = new();

    private async Task CambiarPassword()
    {
        errores = new();

        if (string.IsNullOrWhiteSpace(password) || password.Length < 8)
            errores["password"] = "La contraseña debe tener al menos 8 caracteres.";

        if (password != passwordConfirm)
            errores["passwordConfirm"] = "Las contraseñas no coinciden.";

        if (errores.Count > 0) return;

        resultado = UiResult.EnCarga();

        try
        {
            var ok = await AuthService.ResetPasswordAsync(token!, password);
            if (!ok)
            {
                resultado = UiResult.ConError("El enlace no es válido o ha expirado. Solicita uno nuevo.");
                return;
            }
            resultado = UiResult.Ok();
        }
        catch
        {
            resultado = UiResult.ConError("Ha ocurrido un error. Inténtalo de nuevo.");
        }
    }

    private void TogglePassword() => mostrarPassword = !mostrarPassword;
}
