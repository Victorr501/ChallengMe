@page "/recuperar-password"
@layout PublicLayout
@inject AuthApiService AuthService

<div class="auth-container">
    <div class="auth-card animate-scaleIn">

        <div class="auth-logo">
            Challenge<span>Me!</span>
        </div>

        @if (resultado.Exitoso)
        {
            <div class="alert alert-success animate-fadeIn">
                <span>✓</span>
                <span>Si el email está registrado, recibirás un enlace en breve. Revisa tu bandeja de entrada.</span>
            </div>
        }
        else
        {
            <h1 class="h2" style="text-align:center; margin-bottom: var(--space-xs);">
                Recuperar contraseña
            </h1>
            <p class="text-sm text-muted" style="text-align:center; margin-bottom: var(--space-xl);">
                Introduce tu email y te enviaremos un enlace de recuperación
            </p>

            @if (resultado.TieneError)
            {
                <div class="alert alert-error animate-fadeIn">
                    <span>⚠</span>
                    <span>@resultado.Error</span>
                </div>
            }

            <div class="form-group">
                <label class="form-label" for="email">Email</label>
                <input class="form-input @(errores.ContainsKey("email") ? "input-error" : "")"
                       id="email"
                       type="email"
                       placeholder="tu@email.com"
                       @bind="email"
                       @bind:event="oninput" />
                @if (errores.ContainsKey("email"))
                {
                    <span class="form-error">@errores["email"]</span>
                }
            </div>

            <button class="btn btn-primary btn-full btn-lg"
                    @onclick="Enviar"
                    disabled="@resultado.Cargando">
                @if (resultado.Cargando)
                {
                    <span class="spinner"></span>
                    <span>Enviando...</span>
                }
                else
                {
                    <span>Enviar enlace</span>
                }
            </button>
        }

        <p class="text-sm text-muted" style="text-align:center; margin-top: var(--space-lg);">
            <a href="@AppRouters.Login">Volver al inicio de sesión</a>
        </p>

    </div>
</div>

@code {

    private string email = string.Empty;
    private UiResult resultado = UiResult.Inicial();
    private Dictionary<string, string> errores = new();

    private async Task Enviar()
    {
        errores = new();

        if (string.IsNullOrWhiteSpace(email) || !email.Contains('@'))
        {
            errores["email"] = "Introduce un email válido.";
            return;
        }

        resultado = UiResult.EnCarga();

        try
        {
            await AuthService.RecuperarPasswordAsync(email);
            resultado = UiResult.Ok();
        }
        catch
        {
            resultado = UiResult.ConError("Ha ocurrido un error. Inténtalo de nuevo.");
        }
    }
}
