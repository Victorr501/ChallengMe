@page "/signin-oidc"
@using ChallengMe.Web.Models.Auth
@using ChallengMe.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@layout PublicLayout
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject AuthApiService AuthService

<div class="auth-container">
    <div class="auth-card animate-scaleIn">
        <div class="auth-logo">Challenge<span>Me!</span></div>
        <div class="empty-state">
            <div class="empty-state-icon">⏳</div>
            <p class="empty-state-title">Verificando tu cuenta...</p>
            <p class="text-sm text-muted">Estamos comprobando tu identidad con Microsoft</p>
        </div>
    </div>
</div>

@code {

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var uri = new Uri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (!query.TryGetValue("code", out var code) || string.IsNullOrWhiteSpace(code))
        {
            Navigation.NavigateTo("/login?error=microsoft", forceLoad: true);
            return;
        }

        try
        {
            // LoginMicrosoftAsync ya devuelve AuthResponse? directamente
            // No hay HttpResponseMessage, no hay .IsSuccessStatusCode, no hay .Content
            var authResponse = await AuthService.LoginMicrosoftAsync(code.ToString());

            if (authResponse?.Token is null)
            {
                Navigation.NavigateTo("/login?error=microsoft", forceLoad: true);
                return;
            }

            await JS.InvokeVoidAsync("localStorage.setItem", AuthConstants.JwtKey, authResponse.Token);

            var provider = (JwtAuthStateProvider)AuthStateProvider;
            provider.EstablecerToken(authResponse.Token);

            Navigation.NavigateTo(AppRouters.Dashboard, forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            Navigation.NavigateTo("/login?error=microsoft", forceLoad: true);
        }
    }
}