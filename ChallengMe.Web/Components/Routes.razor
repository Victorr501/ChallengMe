@using ChallengMe.Web.Components.Pages
@using Microsoft.AspNetCore.Components.Authorization

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.AppLayout)">
            <NotAuthorized>
                <RedirectToLogin/>
            </NotAuthorized>
            <Authorizing>
                <p>Verificando acceso...</p>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>